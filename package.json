{
  "name": "@gjlmotea/blockhand-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "BlockHand: MCP server for Minecraft Education Edition over the official /connect (/wsserver) WebSocket. No add-on or behavior pack needed. Agent robot control, 24 build shapes merged into minimal /fill commands, block reading, region comparison and game events.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "minecraft",
    "minecraft-education",
    "minecraft-education-edition",
    "education-edition",
    "wsserver",
    "websocket",
    "agent",
    "code-builder",
    "classroom",
    "edtech",
    "building",
    "claude",
    "claude-code",
    "codex",
    "gemini-cli",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "gjlmotea",
  "homepage": "https://github.com/gjlmotea/blockhand-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjlmotea/blockhand-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gjlmotea/blockhand-mcp/issues"
  },
  "mcpName": "io.github.gjlmotea/blockhand-for-minecraft-education-mcp",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "bin": {
    "blockhand-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/stdio-smoke.mjs",
    "hub-smoke": "node scripts/hub-smoke.mjs",
    "live": "node scripts/live-check.mjs",
    "blockhand": "node scripts/blockhand.mjs",
    "setup:codex": "node scripts/blockhand.mjs install --client=codex",
    "setup:claude": "node scripts/blockhand.mjs install --client=claude",
    "setup:gemini": "node scripts/blockhand.mjs install --client=gemini",
    "setup:grok": "node scripts/blockhand.mjs install --client=grok",
    "doctor": "node scripts/blockhand.mjs doctor",
    "connect": "node scripts/blockhand.mjs connect",
    "uninstall:codex": "node scripts/blockhand.mjs uninstall --client=codex",
    "uninstall:claude": "node scripts/blockhand.mjs uninstall --client=claude",
    "uninstall:gemini": "node scripts/blockhand.mjs uninstall --client=gemini",
    "uninstall:grok": "node scripts/blockhand.mjs uninstall --client=grok",
    "run-plan": "node scripts/run-tools.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke && pnpm run hub-smoke",
    "start": "node dist/index.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
