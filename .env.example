# BlockHand（Minecraft Education MCP）啟動設定
# 這裡沒有任何祕密值；Education Edition 的 WebSocket 橋接不需要帳號或 token。

# 本機 WebSocket 監聽位址。預設只綁 loopback，不對區網開放。
MINECRAFT_EDU_WS_HOST=127.0.0.1

# 本機 WebSocket 監聽埠。遊戲內以 /connect <host>:<port> 連入。
# 診斷／隔離程序可設 0，交由作業系統配發空閒埠。
MINECRAFT_EDU_WS_PORT=19131

# 優先埠被同機其他 MCP task 占用時，由作業系統配發空閒埠。
# 實際指令一律以目前 task 的 mc_status.connectCommand 為準。
MINECRAFT_EDU_WS_PORT_FALLBACK=1

# 單一指令等待遊戲回應的逾時（毫秒）。
MINECRAFT_EDU_COMMAND_TIMEOUT_MS=10000

# 事件環形緩衝的保留筆數上限。
MINECRAFT_EDU_EVENT_BUFFER=500

# 單次建造允許送出的最大方塊數；超過即拒絕，必須拆批。
MINECRAFT_EDU_MAX_BUILD_BLOCKS=200000

# 設成 1 會把遊戲回的每個原始封包印到 stderr。診斷協定行為時才開。
# MINECRAFT_EDU_DEBUG_FRAMES=1
